# secrets.yaml template for espgensam_dial.
# Copy this file to secrets.yaml and fill in your credentials.
#
# If you already keep espgensam's secrets outside the repo, secrets.yaml can instead be a
# one-line include of a shared file, matching espgensam's own pattern:
#
#   <<: !include /path/to/your/secrets/espgensam_dial.yaml
#
# A dedicated api_key per device is recommended over reusing espgensam's.

wifi_ssid: "MyWiFiNetwork"
wifi_password: "MySecretWiFiPassword"
ap_password: "FallbackAccessPointPassword"
api_key: "GENERATE_A_BASE64_KEY_OR_USE_ESPHOME_WIZARD"
